---
// Importa los estilos globales para que Tailwind CSS funcione.
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';

const titulo: string = 'Ingeniería en Informática UTEM';
---

<BaseLayout 
  title={titulo}
  description="Carrera de Ingeniería Civil en Computación mención Informática de la Universidad Tecnológica Metropolitana."
>
  <div class="p-4">
    <h1 class="text-2xl font-bold">{titulo}</h1>
    <p>Sitio en construcción.</p>
  </div>
</BaseLayout>