---
// Respaldo institucional (#31): la certificación de la carrera y la
// acreditación de la universidad, separadas porque no son lo mismo, y los
// datos que no encontramos, declarados en vez de inventarlos.

import { getEntry } from 'astro:content';
import Seccion from './Seccion.astro';
import Cita from './Cita.astro';
import TipoInformacion from './TipoInformacion.astro';
import { fechaLegible } from '../utils/formato';

const respaldo = await getEntry('respaldo', 'ingenieria-en-informatica');
if (!respaldo) {
  throw new Error('Falta src/content/respaldo/ingenieria-en-informatica.json');
}
const { certificacionCarrera, acreditacionInstitucional, noDisponible } = respaldo.data;
---

<Seccion id="respaldo">
  <!-- Dos tarjetas lado a lado en escritorio, una sobre otra en celular. -->
  <div class="grid gap-4 md:grid-cols-2">
    <TipoInformacion tipo="dato_institucional">
      <h3 class="font-titulo text-lg font-bold">Certificación de la carrera</h3>
      <p class="mt-1 font-titulo text-3xl font-bold">{certificacionCarrera.anios} años</p>
      <p class="mt-1">
        Del {fechaLegible(certificacionCarrera.desde)} al {fechaLegible(certificacionCarrera.hasta)}.
        Agencias: {certificacionCarrera.agencias.join(' y ')}. <Cita fuente={certificacionCarrera.fuente.id} />
      </p>
    </TipoInformacion>
    <TipoInformacion tipo="dato_institucional">
      <h3 class="font-titulo text-lg font-bold">Acreditación de la universidad</h3>
      <p class="mt-1 font-titulo text-3xl font-bold">{acreditacionInstitucional.anios} años</p>
      <p class="mt-1">
        Nivel {acreditacionInstitucional.nivel}, {acreditacionInstitucional.vigencia}.
        <Cita fuente={acreditacionInstitucional.fuente.id} />
      </p>
    </TipoInformacion>
  </div>

  <!-- Datos que la pauta pide y no están en las fuentes. Es una declaración
       del equipo, así que se marca como interpretación. -->
  {
    noDisponible.length > 0 && (
      <TipoInformacion tipo="interpretacion_equipo">
        <ul class="list-disc space-y-1 pl-5">
          {noDisponible.map((dato) => <li>{dato}</li>)}
        </ul>
      </TipoInformacion>
    )
  }
</Seccion>
