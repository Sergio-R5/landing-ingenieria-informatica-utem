---
// Envoltorio común de cada sección (#28 a #33). Lee de la colección
// "secciones" el nombre corto y la pregunta, y muestra la pregunta como título,
// como propone la Fase C. Así ningún componente escribe sus títulos a mano.

// getEntry lee una entrada; render convierte su Markdown en HTML.
import { getEntry, render } from 'astro:content';

interface Props {
  // Nombre del archivo en src/content/secciones, sin ".md". También es el
  // ancla de la sección, por ejemplo "admision" para "#admision".
  id: string;
  // Fondo de la sección. Si no se indica, se alterna según su orden (las
  // pares van en blanco), para separar las secciones sin líneas.
  fondo?: 'claro' | 'blanco';
}

const { id, fondo }: Props = Astro.props;

// Si la sección no existe, el build se detiene en vez de mostrar una sección vacía.
const seccion = await getEntry('secciones', id);
if (seccion === undefined) {
  throw new Error(`Falta el archivo src/content/secciones/${id}.md`);
}

// Texto introductorio de la sección, escrito en el cuerpo del Markdown.
const { Content } = await render(seccion);
// Algunas secciones no tienen introducción: su archivo solo trae los datos.
const tieneIntroduccion: boolean = (seccion.body ?? '').trim() !== '';

// id del título, para que la sección se anuncie con su pregunta.
const idTitulo: string = `titulo-${id}`;

// Fondo final: el indicado o, si no, blanco para las secciones pares.
const fondoFinal: 'claro' | 'blanco' = fondo ?? (seccion.data.orden % 2 === 0 ? 'blanco' : 'claro');

// Color de cada sección, según su orden (la 2 es la primera después de la
// portada): da variedad sin perder la unidad. Todos tienen al menos 5,17:1
// con texto blanco (ver global.css). Las tarjetas lo leen con var(--tono).
const colores: string[] = ['violeta', 'verde', 'rosa', 'acento', 'cian', 'naranja', 'violeta', 'cian'];
const tono: string = colores[(seccion.data.orden - 2 + colores.length) % colores.length] ?? 'acento';
---

<!-- scroll-mt deja espacio para el menú fijo al saltar con un enlace.
     aria-labelledby nombra la sección con su pregunta. El fondo "claro" se
     tiñe con el 7 % del color de la sección; --tono guarda ese color. -->
<section
  id={id}
  aria-labelledby={idTitulo}
  class:list={[
    'scroll-mt-24 py-16 md:py-24',
    fondoFinal === 'blanco' ? 'bg-white' : 'bg-[color-mix(in_srgb,var(--tono)_7%,white)]',
  ]}
  style={`--tono: var(--color-${tono})`}
>
  <!-- Ancho máximo legible y margen lateral en celulares. -->
  <div class="mx-auto max-w-6xl px-4">
    <!-- Nombre corto de la sección en una píldora de su color, con texto
         blanco (al menos 5,17:1). -->
    <p class="inline-flex items-center rounded-full bg-(--tono) px-4 py-1.5 text-sm font-bold text-white shadow-sm">
      {seccion.data.titulo}
    </p>
    <!-- La pregunta es el título de nivel 2 de la sección. -->
    <h2 id={idTitulo} class="mt-3 max-w-3xl font-titulo text-3xl leading-tight font-extrabold text-balance md:text-5xl">
      {seccion.data.pregunta}
    </h2>
    <!-- Introducción en Markdown, solo si el archivo tiene texto bajo sus datos.
         space-y separa los párrafos. -->
    {
      tieneIntroduccion && (
        <div class="mt-5 max-w-2xl space-y-3 text-lg leading-relaxed text-texto/80">
          <Content />
        </div>
      )
    }
    <!-- Contenido propio de cada sección. -->
    <div class="mt-10">
      <slot />
    </div>
  </div>
</section>
