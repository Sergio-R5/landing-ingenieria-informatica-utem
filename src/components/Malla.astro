---
// Plan de estudios (#29 y #30): las 44 asignaturas oficiales agrupadas por
// semestre, con sus créditos SCT y su requisito. Sin JavaScript se ve la malla
// completa; con JavaScript aparece un filtro por semestre (la única isla).

// getCollection lee todos los archivos de una colección.
import { getCollection } from 'astro:content';
// Tipo de una entrada de colección, para tipar las listas sin usar any.
import type { CollectionEntry } from 'astro:content';
// Envoltorio común: título en forma de pregunta e introducción de la sección.
import Seccion from './Seccion.astro';
// Número de cita que enlaza a la fuente en Referencias.
import Cita from './Cita.astro';
// Filtro por semestre, la única isla interactiva del sitio.
import FiltroMalla from './FiltroMalla.astro';

// Semestres ordenados del 1 al 8.
const semestres: CollectionEntry<'malla'>[] = (await getCollection('malla')).sort(
  (a, b) => a.data.semestre - b.data.semestre,
);

// Tabla de número → nombre, para mostrar el requisito con su nombre y no solo
// con su número, que una persona que postula no conoce.
const nombres: Map<number, string> = new Map(
  semestres.flatMap((semestre) => semestre.data.asignaturas.map((a) => [a.numero, a.nombre] as const)),
);

// Si el requisito es un número de asignatura, devuelve "Nombre (N.° 16)";
// si es un texto como "Ingreso", lo devuelve tal cual.
function requisitoLegible(requisito: string): string {
  const nombre: string | undefined = nombres.get(Number(requisito));
  return nombre === undefined ? requisito : `${nombre} (N.° ${requisito})`;
}

// Total de créditos de toda la carrera, calculado desde los datos.
const totalSct: number = semestres.reduce(
  (total, semestre) => total + semestre.data.asignaturas.reduce((suma, a) => suma + a.sct, 0),
  0,
);

// Todas las asignaturas citan la misma resolución.
const fuente: string = semestres[0]?.data.fuente.id ?? '';
---

<Seccion id="plan-de-estudios">
  <!-- Total de la carrera con su fuente. -->
  <p class="mb-6 font-semibold">
    {semestres.length} semestres y {totalSct} créditos SCT en total <Cita fuente={fuente} />
  </p>

  <!-- Filtro por semestre. Empieza oculto y solo aparece si hay JavaScript. -->
  <FiltroMalla semestres={semestres.map((s) => s.data.semestre)} />

  <!-- Un bloque por semestre. data-semestre lo usa el filtro. Una columna en
       celular, dos en tableta y cuatro en escritorio. -->
  <ol class="grid gap-4 md:grid-cols-2 xl:grid-cols-4" id="malla-semestres">
    {
      semestres.map((semestre) => {
        // Créditos del semestre; el esquema ya exige que sumen 30.
        const sct: number = semestre.data.asignaturas.reduce((suma, a) => suma + a.sct, 0);
        return (
          <li data-semestre={semestre.data.semestre} class="overflow-hidden rounded-xl border border-borde bg-white">
            {/* Cabecera azul profundo con texto blanco (13,93:1): marca el
                inicio de cada semestre como un tramo de la carrera. */}
            <h3 class="flex items-baseline justify-between bg-profundo px-4 py-3 font-titulo text-lg font-bold text-white">
              Semestre {semestre.data.semestre} <span class="text-sm font-semibold text-suave">{sct} SCT</span>
            </h3>
            {/* Lista de asignaturas: el lector de pantalla anuncia cuántas hay. */}
            <ul class="space-y-3 p-4">
              {semestre.data.asignaturas.map((asignatura) => (
                <li class="border-b border-borde pb-3 last:border-0 last:pb-0">
                  <p class="font-semibold">{asignatura.nombre}</p>
                  <p class="mt-0.5 text-sm text-texto/75">
                    {asignatura.sct} SCT. Requisito: {requisitoLegible(asignatura.requisito)}
                  </p>
                </li>
              ))}
            </ul>
          </li>
        );
      })
    }
  </ol>
</Seccion>
