---
// Portada (#28, rediseño del 11 de noviembre de 2026). Su elemento central son
// las preguntas reales de la encuesta de la Fase B, cada una respondida con
// una cifra oficial y su cita: es la propuesta creativa de la Fase C. Debajo
// va la ficha con los datos que exige la pauta. No usa imágenes, así que el
// elemento más grande es texto y el LCP no depende de una descarga.

// getEntry lee un archivo de datos de src/content por su nombre.
import { getEntry, render } from 'astro:content';
// Número de cita que enlaza a la fuente en Referencias.
import Cita from './Cita.astro';
// Etiqueta visible: dato institucional o interpretación del equipo.
import TipoInformacion from './TipoInformacion.astro';
// Formatos de cifras que pide la guía de estilo.
import { numero, pesos, porcentaje } from '../utils/formato';

// Datos de la carrera, la sección de portada, Mi Futuro, Admisión y las
// preguntas frecuentes que se responden en la portada.
const carrera = await getEntry('carrera', 'ingenieria-en-informatica');
const portada = await getEntry('secciones', 'portada');
const campo = await getEntry('campo-laboral', 'empleabilidad');
const admision = await getEntry('admision', 'admision-2027');
const preguntaDuracion = await getEntry('faq', '01-cuanto-dura');
const preguntaTrabajo = await getEntry('faq', '02-hay-trabajo');
const preguntaSueldo = await getEntry('faq', '06-cuanto-se-gana');
const seccionAdmision = await getEntry('secciones', 'admision');

// Sin estos archivos la portada no tiene contenido: se detiene el build.
if (
  !carrera ||
  !portada ||
  !campo ||
  !admision ||
  !preguntaDuracion ||
  !preguntaTrabajo ||
  !preguntaSueldo ||
  !seccionAdmision
) {
  throw new Error('Faltan datos de la portada en src/content');
}

// Texto de bienvenida, escrito en el cuerpo de portada.md.
const { Content: Bienvenida } = await render(portada);

// Atajos para leer los campos de cada archivo.
const datos = carrera.data;
const mf = campo.data;

// Preguntas de la encuesta con su respuesta. La pregunta sale de la colección
// de preguntas frecuentes o de secciones; la cifra y el período, de los datos
// oficiales. "destino" es la sección donde está la respuesta completa.
const respuestas: {
  pregunta: string;
  cifra: string;
  detalle: string;
  fuentes: string[];
  destino: string;
}[] = [
  {
    pregunta: preguntaDuracion.data.pregunta,
    cifra: `${datos.duracionSemestres} semestres`,
    // La duración real va siempre junto a la formal (guía de estilo).
    detalle: `En la práctica, los ${mf.duracionReal.periodo} tardaron ${numero(mf.duracionReal.semestres)} en promedio.`,
    fuentes: [datos.fuente.id, mf.fuente.id],
    destino: '#plan-de-estudios',
  },
  {
    pregunta: preguntaTrabajo.data.pregunta,
    cifra: porcentaje(mf.empleabilidadPrimerAnio.porcentaje),
    detalle: `de los ${mf.empleabilidadPrimerAnio.periodo} tenía ingresos al primer año.`,
    fuentes: [mf.fuente.id],
    destino: '#campo-laboral',
  },
  {
    pregunta: preguntaSueldo.data.pregunta,
    cifra: `${pesos(mf.ingresoCuartoAnio.desde)} a ${pesos(mf.ingresoCuartoAnio.hasta)}`,
    detalle: `brutos mensuales al cuarto año, en promedio. Mide a los ${mf.ingresoCuartoAnio.periodo}.`,
    fuentes: [mf.fuente.id],
    destino: '#campo-laboral',
  },
  {
    pregunta: seccionAdmision.data.pregunta,
    cifra: `${admision.data.vacantes} vacantes`,
    detalle: `en ${admision.data.proceso}, con un puntaje mínimo de ${admision.data.puntajeMinimo.valor} puntos.`,
    fuentes: [admision.data.fuente.id],
    destino: '#admision',
  },
];

// Colores del borde de cada tarjeta de pregunta, en sus versiones claras para
// que se vean sobre el azul profundo.
const acentos: string[] = ['border-l-resalte', 'border-l-celeste', 'border-l-chicle', 'border-l-lila'];

// Ficha de la carrera: nombre del dato y su valor. Los nombres son etiquetas
// de la interfaz; los valores salen de la colección.
const ficha: { nombre: string; valor: string }[] = [
  { nombre: 'Título profesional', valor: datos.tituloProfesional },
  { nombre: 'Grado académico', valor: datos.gradoAcademico },
  { nombre: 'Duración', valor: `${datos.duracionSemestres} semestres` },
  { nombre: 'Jornada', valor: datos.jornada },
  { nombre: 'Lugar', valor: datos.sede },
];
---

<!-- Portada con el ancla "portada", a la que apunta el menú. -->
<section id="portada" aria-labelledby="titulo-portada" class="scroll-mt-24">
  <!-- Franja azul profunda. El texto blanco tiene contraste 13,93:1.
       relative e isolate crean una capa propia para las decoraciones del
       fondo; overflow-hidden evita que las manchas salgan de la franja. -->
  <div class="relative isolate overflow-hidden bg-profundo text-white">
    <!-- Decoración del fondo. aria-hidden: no tiene contenido, así que el
         lector de pantalla la ignora; pointer-events-none: no tapa los clics. -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <!-- Trama de puntos blancos muy tenues, hecha con un degradado de CSS. -->
      <div class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.12)_1px,transparent_1px)] bg-size-[22px_22px]"></div>
      <!-- Tres manchas de color (violeta arriba a la izquierda, cian a la
           derecha y rosa abajo) hechas con degradados radiales. Son fijas y no
           usan filtros de desenfoque: el navegador las dibuja una sola vez, así
           que no afectan el rendimiento medido por PageSpeed. -->
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_8%_12%,rgba(109,40,217,0.55),transparent_42%),radial-gradient(circle_at_96%_50%,rgba(14,116,144,0.5),transparent_45%),radial-gradient(circle_at_45%_115%,rgba(190,24,93,0.45),transparent_42%)]"
      >
      </div>
    </div>
    <!-- Dos columnas en escritorio: presentación a la izquierda y preguntas a
         la derecha. Una sola columna en celular. -->
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-14 md:py-20 lg:grid-cols-[1fr_1.1fr] lg:items-center">
      <div>
        <!-- Universidad que imparte la carrera. -->
        <p class="font-semibold text-suave">{datos.institucion}</p>
        <!-- Único h1 del sitio: el nombre oficial de la carrera. -->
        <h1 id="titulo-portada" class="mt-3 font-titulo text-5xl leading-[1.05] font-extrabold text-balance md:text-7xl">
          {datos.nombreOficial}
        </h1>
        <!-- Barra decorativa con los colores de las secciones; su degradado se
             desliza una vez al cargar (clase "brillo" de global.css). -->
        <div
          aria-hidden="true"
          class="brillo mt-5 h-1.5 w-40 rounded-full bg-linear-to-r from-lila via-celeste via-50% to-resalte"
        >
        </div>
        <!-- Bienvenida desde portada.md, en azul claro (9,80:1). -->
        <div class="mt-6 max-w-md text-lg leading-relaxed text-suave">
          <Bienvenida />
        </div>
        <!-- Llamado a la acción: amarillo con texto azul profundo (9,09:1).
             Mide 48 px de alto, más que el mínimo de 24×24 px. -->
        <a
          href={datos.llamadoAccion.destino}
          class="mt-8 inline-flex min-h-12 items-center rounded-full bg-resalte px-7 font-bold text-profundo shadow-[0_0_40px_rgba(250,204,21,0.45)] hover:-translate-y-0.5 hover:bg-white hover:shadow-[0_0_50px_rgba(255,255,255,0.5)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-resalte motion-safe:transition"
        >
          {datos.llamadoAccion.texto}
        </a>
      </div>

      <!-- Preguntas de la encuesta, cada una con su respuesta. Es una lista
           porque son elementos del mismo tipo. Cada fila entra con un pequeño
           retraso (clase "entrada" de global.css). Cada una es una tarjeta
           translúcida que deja ver el fondo de color, con un
           borde izquierdo de color distinto. Dos columnas desde 640 px. -->
      <ol class="grid gap-3 sm:grid-cols-2">
        {
          respuestas.map((respuesta, indice) => (
            <li
              class:list={[
                'entrada rounded-2xl border-l-4 bg-white/8 p-5 ring-1 ring-white/10',
                acentos[indice % acentos.length],
              ]}
              style={`--retraso: ${0.15 + indice * 0.12}s`}
            >
              {/* La pregunta enlaza a la sección con la respuesta completa. */}
              <a
                href={respuesta.destino}
                class="inline-flex min-h-6 items-center font-semibold text-suave underline decoration-white/30 underline-offset-4 hover:text-white hover:decoration-resalte focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-resalte"
              >
                {respuesta.pregunta}
              </a>
              {/* La cifra, en amarillo de realce y grande. */}
              <p class="mt-1 font-titulo text-3xl font-extrabold text-resalte">{respuesta.cifra}</p>
              {/* Período que mide y sus citas, en blanco. */}
              <p class="mt-1 text-sm leading-relaxed text-white">
                {respuesta.detalle}{' '}
                {respuesta.fuentes.map((fuente) => (
                  <Cita fuente={fuente} tono="oscuro" />
                ))}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <!-- Ficha con los datos que exige la pauta, sobre fondo claro. -->
  <div class="mx-auto max-w-6xl px-4 py-10">
    <TipoInformacion tipo="dato_institucional">
      <!-- Lista de definiciones: una columna en celular, cinco en escritorio. -->
      <dl class="grid gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-5">
        {
          ficha.map((item) => (
            <div>
              <dt class="text-sm text-texto/70">{item.nombre}</dt>
              <dd class="font-bold">{item.valor}</dd>
            </div>
          ))
        }
      </dl>
      <!-- Una sola cita para toda la ficha: todos los datos salen de la misma fuente. -->
      <p class="mt-3 text-sm">Fuente: <Cita fuente={datos.fuente.id} /></p>
    </TipoInformacion>
  </div>
</section>
