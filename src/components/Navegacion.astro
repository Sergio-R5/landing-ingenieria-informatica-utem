---
// Menú de navegación por anclas (#33). Lee las secciones en su orden, así que
// si se agrega o se mueve una sección, el menú se actualiza solo. Funciona sin
// JavaScript: cada enlace salta a su sección.

// getCollection lee todos los archivos de una colección.
import { getCollection } from 'astro:content';
// Tipo de una entrada de colección, para tipar las listas sin usar any.
import type { CollectionEntry } from 'astro:content';

// Secciones ordenadas del 1 al 9, según docs/fase-c-arquitectura.md.
const secciones: CollectionEntry<'secciones'>[] = (await getCollection('secciones')).sort(
  (a, b) => a.data.orden - b.data.orden,
);
---

<!-- aria-label distingue este menú de otros posibles en la página. -->
<nav aria-label="Secciones del sitio" class="mx-auto max-w-6xl px-4">
  <!-- En celular, los enlaces quedan en una línea que se desliza hacia el lado
       dentro del menú, sin mover la página. En escritorio caben todos. -->
  <ul class="-mx-4 flex gap-1 overflow-x-auto px-4 py-2 text-sm whitespace-nowrap lg:mx-0 lg:justify-center lg:px-0">
    {
      secciones.map((seccion) => (
        <li>
          {/* Cada enlace mide al menos 24 px de alto para tocarlo con el dedo. */}
          <a
            href={`#${seccion.id}`}
            class="inline-flex min-h-9 items-center rounded-full px-3 font-semibold hover:bg-borde focus-visible:outline-2 focus-visible:outline-acento"
          >
            {seccion.data.titulo}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
