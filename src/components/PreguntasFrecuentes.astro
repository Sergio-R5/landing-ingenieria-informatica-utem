---
// Preguntas frecuentes (#32): las 8 preguntas más repetidas en la Fase B.
// Cada una usa <details>, que se abre y cierra con teclado y sin JavaScript.

// getCollection lee todos los archivos de una colección.
import { getCollection } from 'astro:content';
// Tipo de una entrada de colección, para tipar las listas sin usar any.
import type { CollectionEntry } from 'astro:content';
// Envoltorio común: título en forma de pregunta e introducción de la sección.
import Seccion from './Seccion.astro';
// Número de cita que enlaza a la fuente en Referencias.
import Cita from './Cita.astro';
// Etiqueta visible: dato institucional o interpretación del equipo.
import TipoInformacion from './TipoInformacion.astro';

// Preguntas en el orden de prioridad de la Fase B.
const preguntas: CollectionEntry<'faq'>[] = (await getCollection('faq')).sort(
  (a, b) => a.data.orden - b.data.orden,
);
---

<Seccion id="preguntas-frecuentes">
  <div class="max-w-3xl space-y-3">
    {
      preguntas.map((entrada) => (
        <details class="group rounded-xl border border-borde bg-fondo open:bg-white">
          {/* La pregunta es el botón que abre la respuesta. Mide más de 24 px
              de alto. Un h3 dentro mantiene el orden de los títulos. */}
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 focus-visible:outline-2 focus-visible:outline-acento [&::-webkit-details-marker]:hidden">
            <h3 class="font-bold">{entrada.data.pregunta}</h3>
            {/* Signo "+" que gira hasta formar una "x" al abrir. Responde a una
                acción de la persona, y no se anima si pidió reducir el
                movimiento. aria-hidden: el lector ya anuncia si está abierta. */}
            <span
              aria-hidden="true"
              class="grid size-8 shrink-0 place-items-center rounded-full bg-profundo text-lg leading-none font-bold text-white group-open:rotate-45 motion-safe:transition-transform"
            >
              +
            </span>
          </summary>
          <div class="px-5 pb-5">
            {/* Respuesta con su tipo de información y sus fuentes. */}
            <TipoInformacion tipo={entrada.data.tipoInformacion}>
              <p>
                {entrada.data.respuesta}{' '}
                {entrada.data.fuentes.map((fuente) => (
                  <Cita fuente={fuente.id} />
                ))}
              </p>
            </TipoInformacion>
          </div>
        </details>
      ))
    }
  </div>
</Seccion>
