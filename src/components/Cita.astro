---
// Cita breve: un número entre corchetes, como [3], que enlaza a la fuente
// exacta en la lista de Referencias (#21). El número no se escribe a mano: se
// calcula según el orden de las referencias, así nunca queda desfasado.

// getCollection lee los archivos de src/content/referencias.
import { getCollection } from 'astro:content';
// Tipo de una entrada de la colección, para tipar la lista sin usar any.
import type { CollectionEntry } from 'astro:content';

interface Props {
  // ID de la fuente en la matriz, por ejemplo "F05". En los datos viene en el
  // campo fuente, como dato.fuente.id.
  fuente: string;
}

const { fuente }: Props = Astro.props;

// Todas las referencias, ordenadas por ID. Referencias.astro usa el mismo
// orden, así el número de la cita coincide con el de la lista.
const referencias: CollectionEntry<'referencias'>[] = (await getCollection('referencias')).sort(
  (a, b) => a.id.localeCompare(b.id),
);

// Posición de la fuente en la lista (0 si es la primera, -1 si no existe).
const posicion: number = referencias.findIndex((referencia) => referencia.id === fuente);

// Si la fuente no existe, el build se detiene: una cita rota es un dato sin
// respaldo, y la pauta no lo permite.
if (posicion === -1) {
  throw new Error(`La cita apunta a la fuente "${fuente}", que no está en src/content/referencias`);
}

// Número visible de la cita; las personas cuentan desde 1.
const numero: number = posicion + 1;
---

<!-- Enlace a la entrada de Referencias, que tiene el id "ref-" más el ID de
     la fuente. Es un enlace dentro del texto, así que cumple la excepción
     "en línea" de WCAG 2.5.8; igual se le da un mínimo de 24×24 px.
     Usa el color de acento, que tiene contraste 4,94:1 sobre el fondo.
     El aria-label dice a qué lleva, porque "[3]" solo no se entiende. -->
<a
  href={`#ref-${fuente}`}
  class="inline-flex min-h-6 min-w-6 items-center justify-center rounded text-sm font-semibold text-acento underline underline-offset-2 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-acento"
  aria-label={`Fuente ${numero} en Referencias`}
>[{numero}]</a>
