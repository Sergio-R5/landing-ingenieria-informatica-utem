---
// Layout base: concentra el <head>, los metadatos y la estructura común
// (enlace para saltar al contenido, encabezado, contenido y pie) de la página.

// Estilos globales: Tailwind CSS, colores y tipografías de la identidad visual (#15).
// Se importan aquí para que toda página que use este layout los reciba.
import '../styles/global.css';
// Menú de anclas, que lee las secciones de la colección (#33).
import Navegacion from '../components/Navegacion.astro';
// getEntry lee el aviso del pie de página desde src/content/sitio.
import { getEntry } from 'astro:content';

// Props que debe recibir el layout. Los tipos son explícitos, como pide la pauta.
interface Props {
  // Título único de la página, para la pestaña y las redes sociales.
  title: string;
  // Descripción única, para buscadores y redes sociales.
  description: string;
  // Imagen para redes sociales, relativa a la carpeta public. Es opcional:
  // si no existe, no se agrega la etiqueta og:image.
  image?: string;
}

// Lee las props que entrega la página.
const { title, description, image } = Astro.props;

// Ruta base del sitio en GitHub Pages ("/landing-ingenieria-informatica-utem/").
// Toda ruta a un archivo de public debe partir con ella; si no, da error 404.
const base: string = import.meta.env.BASE_URL;

// Dirección absoluta de esta página, usada como enlace canónico y en Open Graph.
const canonicalURL: URL = new URL(Astro.url.pathname, Astro.site);

// Dirección absoluta de la imagen para redes sociales, solo si se entregó una.
const imageURL: URL | undefined = image ? new URL(`${base}${image}`, Astro.site) : undefined;

// Aviso y enlace del pie de página. Si falta el archivo, se detiene el build.
const sitio = await getEntry('sitio', 'sitio');
if (!sitio) {
  throw new Error('Falta src/content/sitio/sitio.json');
}
---

<!doctype html>
<!-- lang="es-CL" declara el idioma de la página, como exige la pauta. -->
<html lang="es-CL">
  <head>
    <!-- Codificación de caracteres, necesaria para tildes y eñes. -->
    <meta charset="utf-8" />
    <!-- Ajusta el ancho al dispositivo, para que el sitio sea responsivo. -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Título y descripción únicos de la página (SEO básico). -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Dirección oficial de la página, para que los buscadores no la dupliquen. -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph: cómo se ve el enlace al compartirlo en redes sociales. -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- La imagen solo se declara si existe, para no enlazar un archivo vacío. -->
    {imageURL && <meta property="og:image" content={imageURL} />}

    <!-- Índice del sitemap que genera @astrojs/sitemap dentro de la ruta base. -->
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <!-- Ícono de la pestaña, guardado en public/favicon.svg. -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <!-- Colores de fondo y texto, y la fuente Inter, definidos en global.css. -->
  <body class="bg-fondo font-texto text-texto">
    <!-- Enlace para saltar al contenido; aparece solo al navegar con teclado.
         Mantiene su tamaño real (más de 24×24 px) y se esconde moviéndolo
         sobre el borde superior; al recibir el foco baja a la vista.
         Con sr-only medía 1×1 px y CompliaScan no lo reconocía (#34). -->
    <a
      href="#main"
      class="fixed top-2 left-2 z-50 inline-flex min-h-11 -translate-y-[200%] items-center rounded-lg bg-acento px-4 font-semibold text-white focus:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-texto"
    >
      Saltar al contenido principal
    </a>

    <!-- Encabezado con el menú, fijo arriba (sticky) en todos los tamaños:
         en celular ocupa una sola línea, así no tapa el contenido. El fondo
         semitransparente con desenfoque deja ver que la página sigue debajo. -->
    <header class="sticky top-0 z-40 border-b border-borde bg-fondo/90 backdrop-blur">
      <Navegacion />
    </header>

    <!-- Contenido de cada página. tabindex="-1" permite recibir el foco al
         usar el enlace para saltar al contenido. -->
    <main id="main" tabindex="-1" class="focus:outline-none">
      <!-- Aquí se inserta lo que la página pone dentro de <BaseLayout>. -->
      <slot />
    </main>

    <!-- Pie de página: aclara que el sitio no es oficial y enlaza al código. -->
    <!-- Fondo azul profundo con texto blanco (13,93:1) y enlace azul claro (9,80:1). -->
    <footer class="relative bg-profundo py-12 text-sm text-white">
      <!-- Franja superior con los colores de las secciones, decorativa. -->
      <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1.5 bg-linear-to-r from-violeta via-rosa to-resalte"></div>
      <div class="mx-auto max-w-6xl space-y-3 px-4">
        <p class="max-w-2xl leading-relaxed">{sitio.data.aviso}</p>
        <p>
          <a
            href={sitio.data.repositorio.url}
            class="inline-flex min-h-6 items-center font-semibold text-suave underline underline-offset-2 hover:text-white focus-visible:outline-2 focus-visible:outline-resalte"
          >
            {sitio.data.repositorio.texto} (sitio externo)
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>
